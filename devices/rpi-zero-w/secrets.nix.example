# Copy this file to `secrets.nix` (gitignored, never committed) and fill in real values.
#
# `secrets.nix` is imported by `devices/rpi-zero-w/configuration.nix`. Keeping it as a plain,
# untracked `.nix` file (instead of e.g. sops-nix/agenix) is a deliberate choice for this
# personal/single-device repo: nothing sensitive ever touches git, and it's still a one-line
# `import` away from being real NixOS config, no extra tooling required.
{
  wifi = {
    ssid = "YOUR_WIFI_SSID";
    # Pre-shared key / WiFi password.
    psk = "YOUR_WIFI_PASSWORD";
  };

  # Public keys only. Add every key that should be allowed to `ssh` in as `root`.
  sshAuthorizedKeys = [
    "ssh-ed25519 AAAA... you@example.com"
  ];
}
